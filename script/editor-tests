#!/usr/bin/env bash
# Runs the editor tests (Assets/Tests/Editor) in a headless Unity.
#
#   script/editor-tests
#
# Unity: $UNITY_EXE, else `unity-editor` on PATH (the unityci images), else the newest
# Unity Hub install on macOS ($UNITY_HOME overrides the Hub folder).
# On CI ($CI=true) the license is $UNITY_LICENSE, a base64 Unity_lic.ulf (Personal, activated once in
# Unity Hub). It is written to Unity's license path for the run and removed on exit. No credentials
# are ever passed to Unity, and the test log is rejected if it echoes anything from the ULF.
set -euo pipefail

cd "$(dirname "$0")/.."
log="$PWD/unity.test.log"
timeout_secs="${UNITY_TEST_TIMEOUT:-1500}"

unity_exe() {
  if [ -n "${UNITY_EXE:-}" ]; then
    echo "$UNITY_EXE"
  elif command -v unity-editor >/dev/null 2>&1; then
    command -v unity-editor
  else
    local home="${UNITY_HOME:-}"
    [ -n "$home" ] || home=$(ls -d /Applications/Unity/Hub/Editor/* 2>/dev/null | tail -n 1 || true)
    [ -n "$home" ] || { echo "Unity not found. Set UNITY_EXE or UNITY_HOME." >&2; exit 1; }
    echo "$home/Unity.app/Contents/MacOS/Unity"
  fi
}

unity=$(unity_exe)
[ -x "$unity" ] || { echo "Unity not executable: $unity" >&2; exit 1; }
echo "[editor-tests] unity: $unity"

ulf_path=""
ulf_values=()
if [ "${CI:-}" = "true" ]; then
  [ -n "${UNITY_LICENSE:-}" ] || { echo "[editor-tests] UNITY_LICENSE is not set; the CI license can't be installed" >&2; exit 1; }
  if [ "$(uname)" = "Darwin" ]; then
    ulf_path="$HOME/Library/Application Support/Unity/Unity_lic.ulf"
  else
    ulf_path="${XDG_DATA_HOME:-$HOME/.local/share}/unity3d/Unity/Unity_lic.ulf"
  fi
  mkdir -p "$(dirname "$ulf_path")"
  (umask 077; printf '%s' "$UNITY_LICENSE" | base64 -d > "$ulf_path") ||
    { rm -f "$ulf_path"; echo "[editor-tests] UNITY_LICENSE is not valid base64" >&2; exit 1; }
  trap 'rm -f "$ulf_path"' EXIT
  grep -q '<root' "$ulf_path" || { echo "[editor-tests] UNITY_LICENSE did not decode to a ULF" >&2; exit 1; }
  # Every long attribute value in the ULF (serial, developer data, ...), to check the log against.
  while IFS= read -r value; do
    ulf_values+=("$value")
  done < <(grep -oE 'Value="[^"]{16,}"' "$ulf_path" | sed -e 's/^Value="//' -e 's/"$//')
  echo "[editor-tests] license: ULF installed"
fi

rm -f "$log"
status=0
# A wedged Unity is killed by timeout (absent on stock macOS) so the EXIT trap still removes the ULF.
runner=()
command -v timeout >/dev/null 2>&1 && runner=(timeout "$timeout_secs")
${runner[@]+"${runner[@]}"} "$unity" -batchmode -nographics -quit \
  -logFile "$log" -projectPath "$PWD" \
  -executeMethod TeakTestRunner.RunAll || status=$?

# The log is uploaded as a CI artifact. Fail closed if it holds anything from the license.
if [ -f "$log" ]; then
  for value in ${ulf_values[@]+"${ulf_values[@]}"}; do
    if grep -qF -e "$value" "$log"; then
      rm -f "$log"
      echo "[editor-tests] FAILED: the Unity log contained license data; removed it" >&2
      exit 1
    fi
  done
fi

if [ -f "$log" ]; then
  grep -m1 '^Unity Editor version:' "$log" || true
  grep '\[TeakTest\]' "$log" || true
fi

if [ "$status" -ne 0 ]; then
  echo "[editor-tests] FAILED: Unity exited $status" >&2
  exit "$status"
fi

# An empty run reports "0 passed, 0 failed" and exits 0, which must not count as green.
passed=$(sed -n 's/.*\[TeakTest\] ---- Results: \([0-9][0-9]*\) passed, 0 failed ----.*/\1/p' "$log" | tail -n 1)
if [ -z "$passed" ] || [ "$passed" -eq 0 ]; then
  echo "[editor-tests] FAILED: no passing results line with at least one test in $log" >&2
  exit 1
fi
echo "[editor-tests] OK: $passed passed"
